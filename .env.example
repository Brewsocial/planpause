ANTHROPIC_API_KEY=
PLANPAUSE_MODEL=claude-opus-5-5
# Langes Zufallspasswort, z. B. `openssl rand -hex 24`. Mit Supabase wird "bitte-aendern" abgelehnt.
PLANPAUSE_ADMIN_TOKEN=bitte-aendern
PLANPAUSE_DAILY_ANALYSES=20
# KI-Analyse: Gründlichkeit (low|medium|high|xhigh|max), Denkbudget in Tokens (mind. 20000),
# Vollständigkeits-Check als zweiter Durchgang (0|1). Qualität geht vor Kosten.
PLANPAUSE_EFFORT=high
PLANPAUSE_TASK_BUDGET=80000
PLANPAUSE_REVIEW=0

# Supabase (Dashboard → Project Settings → API). Leer = lokaler Modus mit Dateiablage und Demo-Schlüssel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# GEHEIM: Service-/Secret-Key, nur auf dem API-Server, nie in die Web-App
SUPABASE_SERVICE_KEY=

# Öffentliche Adressen im Betrieb
PLANPAUSE_SITE_URL=http://localhost:3000
PLANPAUSE_API_URL=http://localhost:8000
PLANPAUSE_CORS=http://localhost:3000
