{
  // Cloudflare Worker: statische Web-App aus "out" plus Weiterleitung der API-Aufrufe (worker/index.js)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planpause",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Adresse der Planpause-API (Tunnel zum Mac). Bei neuer Tunnel-Adresse hier in beiden wrangler.jsonc ändern
  // und pushen; eine Änderung nur im Cloudflare-Dashboard wird beim nächsten Deployment überschrieben.
  "vars": { "API_ORIGIN": "https://vote-drug-studio-mai.trycloudflare.com" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
