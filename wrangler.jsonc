{
  // Cloudflare-Build aus dem Hauptordner des Repositorys (Root directory "/").
  // Gleiche Einstellungen wie web/wrangler.jsonc, nur mit Pfaden relativ zum Hauptordner.
  "$schema": "web/node_modules/wrangler/config-schema.json",
  "name": "planpause",
  "main": "web/worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Adresse der Planpause-API (Tunnel zum Mac). Bei neuer Tunnel-Adresse hier in beiden wrangler.jsonc ändern
  // und pushen; eine Änderung nur im Cloudflare-Dashboard wird beim nächsten Deployment überschrieben.
  "vars": { "API_ORIGIN": "https://accidents-prescription-primary-produces.trycloudflare.com" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
